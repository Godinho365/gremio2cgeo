DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://patrimonia:patrimonia@db:5432/patrimonia
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pagamento por Pix (Mercado Pago). Pegue em: Suas integrações > sua aplicação.
# Sem estas variáveis o Pix fica desligado e o corte avulso não pode ser marcado.
# NUNCA coloque o token real aqui: este arquivo vai para o repositório.
# O valor de verdade vai em backend/.env, que é ignorado pelo git.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional. Só preencha se este backend tiver endereço público; sem isso a
# confirmação vem da consulta periódica ao Mercado Pago (Celery beat).
MERCADOPAGO_NOTIFICATION_URL=
PIX_EXPIRY_MINUTES=15
# Preço do corte avulso. Coloque 1.00 para testar a cobrança de verdade.
WALK_IN_PRICE=15.00
# Intervalo, em segundos, da consulta de fundo aos pagamentos pendentes.
PIX_SYNC_SECONDS=60
